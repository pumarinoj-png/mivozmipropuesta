# Copia este archivo como .env.local para desarrollo local.
# En Vercel, configura las mismas variables en Settings > Environment Variables.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).

# --- Coach de IA (obligatoria para activarlo) ---
ANTHROPIC_API_KEY=
# Opcional. Por defecto claude-sonnet-5-5. claude-haiku-5-5 es más rápido y barato.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Guardado del trabajo y panel /admin ---
# Contraseña para entrar a /admin (elige una larga, de 16+ caracteres)
ADMIN_PASSWORD=
# Redis (Upstash). Si instalas la integración desde Vercel, estas variables se crean solas
# (con nombres KV_REST_API_URL y KV_REST_API_TOKEN, que la app también reconoce).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Opcionales ---
# Días que se conserva el trabajo guardado (por defecto 90)
RETENTION_DAYS=90
# Límites del coach (valores por defecto pensados para ~60 personas)
COACH_LIMIT_PER_PERSON_HOUR=80
COACH_LIMIT_PER_IP_10MIN=1000
COACH_DAILY_CAP=6000
